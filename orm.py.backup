# main.py (nuevo, versión PostgreSQL + SQLAlchemy async)
from sqlalchemy import Table, Column, Integer, String, DateTime, ForeignKey, Text, Boolean, func
from datetime import datetime
from typing import List
from sqlalchemy import (
    Table,
    Column,
    Integer,
    String,
    DateTime,
    ForeignKey,
    Text,
    UniqueConstraint,
    func,
)
from sqlalchemy.orm import Mapped, mapped_column, relationship

from db_connection import Base


# ===========================
# Tablas de asociación (M2M)
# ===========================
caso_competencia = Table(
    "CASO_COMPETENCIA",
    Base.metadata,
    Column("caso_id", ForeignKey("CASO.id", ondelete="CASCADE"), primary_key=True),
    Column("competencia_id", ForeignKey("COMPETENCIA.id", ondelete="CASCADE"), primary_key=True),
)

resultado_competencia = Table(
    "RESULTADO_COMPETENCIA",
    Base.metadata,
    Column("resultado_id", ForeignKey("RESULTADO_APRENDIZAJE.id", ondelete="CASCADE"), primary_key=True),
    Column("competencia_id", ForeignKey("COMPETENCIA.id", ondelete="CASCADE"), primary_key=True),
)

programa_caso = Table(
    "PROGRAMA_CASO",
    Base.metadata,
    Column("programa_id", ForeignKey("PROGRAMA.id", ondelete="CASCADE"), primary_key=True),
    Column("caso_id", ForeignKey("CASO.id", ondelete="CASCADE"), primary_key=True),
)


# ==========
# ENTIDADES
# ==========
class Usuario(Base):
    __tablename__ = "USUARIO"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True, index=True)
    nombre_usuario: Mapped[str] = mapped_column(String(50), unique=True, nullable=False)
    correo_electronico: Mapped[str] = mapped_column(String(254), unique=True, nullable=False)
    contrasena_hash: Mapped[str] = mapped_column(String(255), nullable=False)
    rol: Mapped[str] = mapped_column(String(20), nullable=False, default="estudiante")
    fecha_creacion: Mapped[datetime] = mapped_column(DateTime, server_default=func.now(), nullable=False)

    # relaciones
    casos_creados: Mapped[List["Caso"]] = relationship("Caso", back_populates="creador")


class PerfilEgreso(Base):
    __tablename__ = "PERFIL_EGRESO"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    nombre: Mapped[str] = mapped_column(String(100), unique=True, nullable=False)
    descripcion: Mapped[str | None] = mapped_column(String(500))

    # relaciones
    programas: Mapped[List["Programa"]] = relationship("Programa", back_populates="perfil_egreso")
    resultados: Mapped[List["ResultadoAprendizaje"]] = relationship(
        "ResultadoAprendizaje", back_populates="perfil_egreso"
    )


class Programa(Base):
    __tablename__ = "PROGRAMA"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    nombre: Mapped[str] = mapped_column(String(100), nullable=False)
    codigo: Mapped[str] = mapped_column(String(20), unique=True, nullable=False)
    descripcion: Mapped[str | None] = mapped_column(String(500))
    perfil_egreso_id: Mapped[int | None] = mapped_column(ForeignKey("PERFIL_EGRESO.id"))
    fecha_creacion: Mapped[datetime] = mapped_column(DateTime, server_default=func.now(), nullable=False)

    # relaciones
    perfil_egreso: Mapped["PerfilEgreso"] = relationship("PerfilEgreso", back_populates="programas")
    casos: Mapped[List["Caso"]] = relationship(
        "Caso", secondary=programa_caso, back_populates="programas"
    )


class Competencia(Base):
    __tablename__ = "COMPETENCIA"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    nombre: Mapped[str] = mapped_column(String(100), unique=True, nullable=False)
    descripcion: Mapped[str | None] = mapped_column(String(500))

    # relaciones
    casos: Mapped[List["Caso"]] = relationship(
        "Caso", secondary=caso_competencia, back_populates="competencias"
    )
    resultados: Mapped[List["ResultadoAprendizaje"]] = relationship(
        "ResultadoAprendizaje", secondary=resultado_competencia, back_populates="competencias"
    )


class ResultadoAprendizaje(Base):
    __tablename__ = "RESULTADO_APRENDIZAJE"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    perfil_egreso_id: Mapped[int] = mapped_column(ForeignKey("PERFIL_EGRESO.id"), nullable=False)
    nombre: Mapped[str] = mapped_column(String(100), nullable=False)
    descripcion: Mapped[str | None] = mapped_column(String(500))

    __table_args__ = (
        UniqueConstraint("perfil_egreso_id", "nombre", name="uq_resultado_unico"),
    )

    # relaciones
    perfil_egreso: Mapped["PerfilEgreso"] = relationship("PerfilEgreso", back_populates="resultados")
    competencias: Mapped[List["Competencia"]] = relationship(
        "Competencia", secondary=resultado_competencia, back_populates="resultados"
    )


class Caso(Base):
    __tablename__ = "CASO"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    titulo: Mapped[str] = mapped_column(String(200), nullable=False)
    descripcion: Mapped[str] = mapped_column(Text, nullable=False)
    fecha_creacion: Mapped[datetime] = mapped_column(DateTime, server_default=func.now(), nullable=False)
    creador_id: Mapped[int] = mapped_column(ForeignKey("USUARIO.id"), nullable=False)

    # relaciones
    creador: Mapped["Usuario"] = relationship("Usuario", back_populates="casos_creados")
    competencias: Mapped[List["Competencia"]] = relationship(
        "Competencia", secondary=caso_competencia, back_populates="casos"
    )
    programas: Mapped[List["Programa"]] = relationship(
        "Programa", secondary=programa_caso, back_populates="casos"
    )
